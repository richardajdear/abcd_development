__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/

# ABCD pipeline outputs (regenerate with: python -m abcd.assemble configs/<x>.yaml)
out/

# R droppings
Rplots.pdf

# Transient image-preview files written by agent sessions inspecting figures.
# These appear here (rather than in a scratch dir) whenever the interpreter's
# working directory is the repo root; they are never analysis outputs.
_view_*.png

# Quarto
*_files/
*.html

# setuptools build artefacts (created by `pip install -e .`, machine-specific)
src/*.egg-info/
build/
dist/

# Machine-specific HPC path overrides (see hpc/config.local.sh.example).
hpc/config.local.sh

# Scratch tree for local pipeline tests: synthetic genotypes, GRMs, GWAS output.
scratch/

# Vendored ABCD release data: large and access-controlled, never committed.
# Living inside the repo is what makes ABCD_ROOT unnecessary (see paths.py).
abcd-data-release-*/
abcd-[0-9]*.[0-9]*/

# Manifest written by `make audit-artifacts`: a snapshot of local file sizes and
# checksums, meaningful only on the machine that produced it.
.artifact_audit.json

# ---------------------------------------------------------------------------
# CSD3 working tree (hpc/work/).  Everything in here is either huge, rebuildable,
# machine-specific, or access-controlled:
#
#   pheno/ pheno_prs/   SUBJECT-LEVEL ABCD phenotypes and covariates -- never
#                       commit these, they are access-controlled data
#   results/gwas/       ~620 MB per phenotype of fastGWA output
#   sumstats/           ~1.5 GB of PGC summary statistics
#   envs/ mamba/ bin/   micromamba environments and vendored binaries
#   genotype/ ldsc_ref/ copies of reference and genotype data
#   genesets/           third-party published supplementary tables; the
#                       make_*_genesets.py scripts record the URLs and md5s
#
# The exceptions are the scripts written for this run and the small result
# summary tables, which are the actual work product.
hpc/work/*
!hpc/work/*.py
!hpc/work/*.sbatch
!hpc/work/*.sh

# Result summaries only (a few KB each); everything else under results/ is
# regenerable output measured in hundreds of megabytes.
!hpc/work/results/
hpc/work/results/*
!hpc/work/results/*/
hpc/work/results/*/*
!hpc/work/results/*/*_summary.tsv
!hpc/work/results/prs/prs_association.tsv

# SLURM stderr scratch, and the convenience symlink to hpc/work/out.
hpc/slurm/
/out
