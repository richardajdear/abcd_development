__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/

# ABCD pipeline outputs (regenerate with: python -m abcd.assemble configs/<x>.yaml)
out/

# R droppings
Rplots.pdf

# Transient image-preview files written by agent sessions inspecting figures.
# These appear here (rather than in a scratch dir) whenever the interpreter's
# working directory is the repo root; they are never analysis outputs.
_view_*.png

# Quarto
*_files/
*.html

# setuptools build artefacts (created by `pip install -e .`, machine-specific)
src/*.egg-info/
build/
dist/

# Machine-specific HPC path overrides (see hpc/config.local.sh.example).
hpc/config.local.sh

# Scratch tree for local pipeline tests: synthetic genotypes, GRMs, GWAS output.
scratch/

# Vendored ABCD release data: large and access-controlled, never committed.
# Living inside the repo is what makes ABCD_ROOT unnecessary (see paths.py).
abcd-data-release-*/
abcd-[0-9]*.[0-9]*/

# Manifest written by `make audit-artifacts`: a snapshot of local file sizes and
# checksums, meaningful only on the machine that produced it.
.artifact_audit.json
